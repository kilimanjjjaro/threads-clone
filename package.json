{
  "name": "threads-clone",
  "description": "Demo App with Routing built-in (recommended)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/vercel-edge/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "vercel deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm fmt.check && pnpm build.types && pnpm lint && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.4",
    "@builder.io/qwik-city": "1.20.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.18",
    "eslint": "10.15.0",
    "eslint-plugin-qwik": "1.20.4",
    "globals": "17.14.0",
    "postcss": "8.4.35",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.12",
    "tailwindcss": "3.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "undici": "6.7.1",
    "vercel": "33.5.5",
    "vite": "7.3.8",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@builder.io/qwik-react": "0.5.8",
    "@cloudinary/url-gen": "1.22.1",
    "@unpic/qwik": "1.0.0",
    "dayjs": "1.11.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "swiper": "14.4.0"
  },
  "volta": {
    "node": "26.13.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
